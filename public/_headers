# Global Security & Edge Acceleration Headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Access-Control-Allow-Origin: *
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Edge Cache-First for Compiled Hashed Assets (Infinite Edge & Client Cache)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Fast Edge Caching for Fonts & WASM Binaries
*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

*.wasm
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/wasm
  Access-Control-Allow-Origin: *

# Edge Caching for Static Images & Icons
*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

*.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# Edge Caching for Metadata & SEO
/manifest.json
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: all
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/robots.txt
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: all
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/version.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *

# Always Fetch Latest HTML on all dynamic route endpoints (Zero Stale Caches)
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/chat
  Cache-Control: public, max-age=0, must-revalidate

/intro
  Cache-Control: public, max-age=0, must-revalidate

/why-switch
  Cache-Control: public, max-age=0, must-revalidate

/downloads
  Cache-Control: public, max-age=0, must-revalidate

/switch-user
  Cache-Control: public, max-age=0, must-revalidate

